{
  "name": "folder-concatenator",
  "version": "2.1.0",
  "description": "Multi-folder file concatenator with context and code-block extraction",
  "author": "Folder Concatenator Contributors",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win",
    "dev-build": "electron-builder --win --dir"
  },
  "build": {
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "src/**/*",
      "README.md",
      "!test/**/*"
    ],
    "appId": "io.folderconcatenator.desktop",
    "productName": "FolderConcatenator",
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "tree-sitter-python": "^0.25.0",
    "web-tree-sitter": "^0.25.10"
  }
}
